# Headroom configuration for Alpha IO — copy to .env (or export) to use.
# Everything here is OFF by default; the trading paths run identically without it.

# --- Library adapter (utils/headroom_compress.py) ---
# Turn on opt-in inline compression at wired seams (signal_augment, rag_macro).
# Leave unset/0 to keep prompts/outputs byte-identical (recommended default).
# ALPHAIO_HEADROOM=1
# Where per-call savings are appended (JSONL). Default: ~/.headroom/alphaio_savings.jsonl
# ALPHAIO_HEADROOM_LOG=/var/log/alphaio/headroom_savings.jsonl

# --- Proxy (zero-code route; only if you choose to front the provider) ---
# Start: headroom proxy --port 8787 --mode cache
# Then route OpenAI-compatible clients through it:
# OPENAI_BASE_URL=http://127.0.0.1:8787/v1
# Pair with the MCP server so the model can expand <<ccr:...>> pointers on demand:
#   headroom mcp install

# --- Measured (not estimated) output-token savings ---
# Requires live provider responses; set before sending real traffic through the proxy.
# HEADROOM_OUTPUT_HOLDOUT=0.1
